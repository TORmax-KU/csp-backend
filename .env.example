PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/fullstack_db

FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

SESSION_SECRET=

# Runs at backend startup and every five minutes (Docker is optional).
GPROC_INGESTION_ENABLED=true
# Optional authorized access. Never commit tokens. Cloudflare currently blocks
# unattended public search; setting this alone does not complete detail mapping.
GPROC_ANNOUNCEMENT_TOKEN=

# Bangkok e-GP import runs on startup and every five minutes; detail/TOR
# enrichment processes this many projects per tick after each import.
BANGKOK_INGESTION_ENABLED=true
BANGKOK_ENRICH_BATCH=5
# Listings fetched per run (pages of 100 stop early when the API has no next page)
EGP_INGEST_PAGES=10
EGP_INGEST_LIMIT=100

VERTEX_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT="tormax-vertex"
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash
TOR_ALLOWED_HOSTS=egp2.bangkok.go.th,adminapiegp.bangkok.go.th
