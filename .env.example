# Copy this file to .env inside csp-backend (only if .env does not exist).
# Use your own credentials below; never commit .env or credential JSON files.
# See README.md for full local, Docker, OAuth, and Vertex AI setup.

# Local Node server. Root Docker Compose overrides PORT to 5000 and exposes 5001.
PORT=5001
# Local MongoDB (each teammate uses their own database).
# For root Docker Compose, use mongodb://mongo:27017/fullstack_db instead.
MONGO_URI=

FRONTEND_URL=http://localhost:3000

# Optional Google login; public browsing works without these credentials.
# Register the exact callback URL below in your Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# Set a unique random value locally; required in production.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Runs at backend startup and every five minutes (Docker is optional).
INGESTION_ENABLED=true
# Run only one ingestion-enabled backend per database.
EGAT_INGESTION_ENABLED=true
IEAT_INGESTION_ENABLED=true
GISTDA_INGESTION_ENABLED=true

# Both national discovery providers use a rolling two-calendar-month publication cutoff.
# Enable each provider after adding its API key.
TERO_INGESTION_ENABLED=false
TERO_API_KEY=
# Local testing only; production needs a dedicated provider key.
TERO_ALLOW_PUBLIC_DEV_KEY=false
GOVSPENDING_INGESTION_ENABLED=false
GOVSPENDING_API_KEY=

# Bangkok e-GP import runs on startup and every five minutes; detail/TOR
# enrichment processes this many projects per tick after each import.
BANGKOK_INGESTION_ENABLED=true
BANGKOK_ENRICH_BATCH=25
# Listings fetched per run (pages of 100 stop early when the API has no next page)
EGP_INGEST_PAGES=20
EGP_INGEST_LIMIT=100
# Optional overrides; omit EGP_BUDGET_YEAR to use the current Thai budget year.
# EGP_BUDGET_YEAR=2570
# EGP_API_URL=https://egp2.bangkok.go.th/project-search
EGP_REQUEST_TIMEOUT_MS=120000
GISTDA_PER_PAGE=50
GISTDA_MAX_PAGES=20

# Optional AI analysis. Configure project, model, and ADC before enabling.
# Newly imported projects need completed analysis to appear in the public feed.
VERTEX_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set a Gemini model ID available in your project with PDF and structured output.
VERTEX_MODEL=
# Local Node uses Application Default Credentials from:
# gcloud auth application-default login
# Docker: set GOOGLE_ADC_HOST_PATH in your shell and use docker-compose.vertex.yaml.
# The Compose override mounts ADC and sets GOOGLE_APPLICATION_CREDENTIALS for you.

# Comma-separated approved hosts for TOR document downloads.
TOR_ALLOWED_HOSTS=egp2.bangkok.go.th,adminapiegp.bangkok.go.th,bidding.egat.co.th,process.gprocurement.go.th,process3.gprocurement.go.th,process5.gprocurement.go.th,run-procurement.terodigital.com
